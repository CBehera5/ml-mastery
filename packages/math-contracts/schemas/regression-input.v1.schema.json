{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlmathlab.local/schemas/regression-input.v1.schema.json",
  "title": "Linear regression input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["features", "targets", "weights", "bias"],
  "properties": {
    "features": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "number" } } },
    "targets": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "number" } },
    "weights": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "number" } },
    "bias": { "type": "number" },
    "learningRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
    "iterations": { "type": "integer", "minimum": 1, "maximum": 1000 }
  }
}
