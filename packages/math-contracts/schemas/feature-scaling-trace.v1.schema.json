{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlmathlab.local/schemas/feature-scaling-trace.v1.schema.json",
  "title": "Standard feature scaling trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "original", "mean", "scale", "scaled"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "method": { "const": "standard" },
    "original": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "number" } } },
    "mean": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "scale": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "scaled": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "number" } } }
  }
}
