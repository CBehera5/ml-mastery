{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlmathlab.dev/schemas/linear-neuron-input.v1.schema.json",
  "title": "Linear neuron calculation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputs", "weights", "bias", "target", "learningRate"],
  "properties": {
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "weights": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "bias": { "type": "number" },
    "target": { "type": "number" },
    "learningRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
  }
}

